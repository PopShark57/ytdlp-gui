<?xml version="1.0" encoding="UTF-8"?>
<!-- Hermetic DASH fixture for the engine integration tests: one H.264 video-only and one AAC
     audio-only representation, as YouTube serves them, so yt-dlp selects "video+audio" and the
     AVFoundation merger has to combine them. -->
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT3S" minBufferTime="PT1S" profiles="urn:mpeg:dash:profile:isoff-on-demand:2011">
  <Period>
    <AdaptationSet mimeType="video/mp4" contentType="video">
      <Representation id="v360" codecs="avc1.64001e" width="640" height="360" frameRate="30" bandwidth="150000">
        <BaseURL>dash-video.mp4</BaseURL>
      </Representation>
    </AdaptationSet>
    <AdaptationSet mimeType="audio/mp4" contentType="audio" lang="en">
      <Representation id="a96" codecs="mp4a.40.2" audioSamplingRate="44100" bandwidth="96000">
        <BaseURL>dash-audio.m4a</BaseURL>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
